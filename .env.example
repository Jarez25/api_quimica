# ==========================================
# CONFIGURACIÓN DEL SERVIDOR & BASE DE DATOS
# ==========================================
PORT=3000
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.9w7rc.mongodb.net/quimica?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# ==========================================
# PROVEEDORES DE INTELIGENCIA ARTIFICIAL (IA)
# (Puedes usar cualquiera de las opciones gratuitas o OpenAI)
# ==========================================

# OPCIÓN 1 (RECOMENDADA - 100% GRATIS): Google Gemini Flash
# Obtén tu API Key gratis en: https://aistudio.google.com/app/apikey
# Sin tarjeta de crédito. Límite generoso (15 RPM / 1 millón tokens/min)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-1.5-flash

# OPCIÓN 2 (100% GRATIS - ULTRA RÁPIDO): Groq Cloud
# Obtén tu API Key gratis en: https://console.groq.com/keys
# Inferencia con Llama 3.3 70B de altísima velocidad
GROQ_API_KEY=gsk_tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# OPCIÓN 3 (OPCIONAL): OpenRouter Free Tier
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu_key_aqui
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OPCIÓN 4 (DE PAGO): OpenAI Oficial
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu_key_de_openai
OPENAI_MODEL=gpt-4o-mini
